<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Aspect colours (chips, filters, deck list). The keys end with the aspect code, see AspectBrushConverter. -->
    <SolidColorBrush x:Key="Aspect.hero" Color="#D9B8FF" />
    <SolidColorBrush x:Key="Aspect.basic" Color="#CFCFCF" />
    <SolidColorBrush x:Key="Aspect.justice" Color="#F2C94C" />
    <SolidColorBrush x:Key="Aspect.aggression" Color="#FF9A8F" />
    <SolidColorBrush x:Key="Aspect.protection" Color="#7FD99A" />
    <SolidColorBrush x:Key="Aspect.leadership" Color="#8FC9FF" />

    <!-- Resource tiles (decision U7). -->
    <SolidColorBrush x:Key="Resource.Energy" Color="#F2C94C" />
    <SolidColorBrush x:Key="Resource.Physical" Color="#FF9A8F" />
    <SolidColorBrush x:Key="Resource.Mental" Color="#8FC9FF" />
    <SolidColorBrush x:Key="Resource.Wild" Color="#7FD99A" />
    <SolidColorBrush x:Key="Resource.Other" Color="#CFCFCF" />

    <!-- Surfaces (decision U5: solid black panels over the nebula background). -->
    <SolidColorBrush x:Key="PanelBrush" Color="#101010" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#C5C5C5" />
    <SolidColorBrush x:Key="DimTextBrush" Color="#A8A8A8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="StatBrush" Color="#222222" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#222222" />

    <!-- Status: complete / incomplete. -->
    <SolidColorBrush x:Key="StatusOkBackground" Color="#1F3B2A" />
    <SolidColorBrush x:Key="StatusOkForeground" Color="#9BE3B0" />
    <SolidColorBrush x:Key="StatusBadBackground" Color="#4A3A14" />
    <SolidColorBrush x:Key="StatusBadForeground" Color="#FCD770" />

    <!-- Deck editor rows. -->
    <SolidColorBrush x:Key="HeroRowBrush" Color="#2F2A3A" />
    <SolidColorBrush x:Key="UsedRowBrush" Color="#0F2A3A" />
    <SolidColorBrush x:Key="UsedRowTextBrush" Color="#7FD0FF" />

    <!-- Navigation column: vertical gradient (decision U5). -->
    <LinearGradientBrush x:Key="NavigationColumnBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#43415A" />
        <GradientStop Offset="1" Color="#646066" />
    </LinearGradientBrush>
</ResourceDictionary>
